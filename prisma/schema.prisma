datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

// Single-row shop configuration (id is always 1).
model Setting {
  id                    Int      @id @default(1)
  shopName              String   @default("My Repair Shop")
  address               String   @default("")
  phone                 String   @default("")
  email                 String   @default("")
  taxLabel              String   @default("HST")
  taxRateBps            Int      @default(1300) // basis points: 1300 = 13.00%
  warrantyDays          Int      @default(90)
  technicians           String   @default("") // newline separated
  benches               String   @default("") // newline separated
  receiptFooter         String   @default("Please back up your data. Devices left unclaimed for 30 days may incur storage fees.")
  nextTicketNumber      Int      @default(1) // sequential work order counter
  defaultLaborRateCents Int      @default(8500) // basis cents: 8500 = $85.00
  enableSoundBeeps      Boolean  @default(true)
  requireIntakeSignature Boolean @default(true)
  currencySymbol        String   @default("$")
  dateFormat            String   @default("YYYY-MM-DD")
  updatedAt             DateTime @updatedAt
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique
  name         String
  passwordHash String
  role         String     @default("USER") // ADMIN | USER
  status       String     @default("ACTIVE") // ACTIVE | DISABLED
  phone        String?
  bio          String?
  bench                 String?    @default("Bench #01")
  preferences           String     @default("{}") // JSON: { soundFX: true, compactView: false, emailAlerts: true }
  lastLoginAt           DateTime?
  employeeNumber        String?    @unique
  hourlyRateCents       Int        @default(2200) // basis cents: 2200 = $22.00/hr
  overtimeRateCents     Int?       // basis cents: defaults to 1.5x hourlyRateCents if null
  vacationPayPct        Int        @default(400)  // basis points: 400 = 4.00%
  td1FederalClaimCents  Int        @default(1612900) // $16,129 basic personal amount
  td1OntarioClaimCents  Int        @default(1274600) // $12,746 Ontario personal claim
  sin                   String?
  shifts                Shift[]
  wageRates             WageRate[]
  paystubs              Paystub[]
  sessions              Session[]
  auditLogs             AuditLog[] @relation("UserAuditLogs")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([role])
  @@index([status])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  actorName String
  action    String   // e.g. LOGIN, LOGOUT, USER_CREATE, USER_UPDATE, USER_DELETE, ROLE_CHANGE, STATUS_CHANGE, PASSWORD_RESET, SETTINGS_UPDATE
  details   String
  ipAddress String?
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model Customer {
  id          String   @id @default(uuid())
  fullName    String
  phone       String // as entered, for display
  phoneDigits String   @unique // digits only, used for de-duplication
  altPhone    String?  // alternative contact phone (strictly optional)
  email       String?
  address     String?
  notes       String?
  devices     Device[]
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fullName])
}

model Device {
  id           String   @id @default(uuid())
  customerId   String
  name         String // e.g. "Apple iPhone 15 Pro"
  serialNumber String?
  passcode     String?
  pattern      String? // unlock pattern as dot order, e.g. "1-2-5-8"
  condition    String? // intake cosmetic notes, comma separated
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tickets      Ticket[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@index([serialNumber])
}

model Ticket {
  id               String        @id @default(uuid())
  ticketNumber     Int           @unique
  customerId       String
  deviceId         String
  status           String        @default("PENDING") // PENDING | IN_PROGRESS | WAITING_ON_PARTS | COMPLETED
  priority         String        @default("STANDARD") // LOW | STANDARD | URGENT
  faultDescription String
  laborCents       Int           @default(0) // service / labor charge quoted at intake
  discountCents    Int           @default(0)
  taxRateBps       Int // tax rate snapshot taken when the ticket was created
  technician       String?
  bench            String?
  storageBin       String?
  signature        String?       // customer intake/pickup authorization signature data-url
  diagnostics      String        @default("{}") // JSON map of QA check -> PASS | FAIL
  dueDate          DateTime
  completedAt      DateTime?
  deletedAt        DateTime?
  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  device           Device        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  items            TicketItem[]
  payments         Payment[]
  events           TicketEvent[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([dueDate])
  @@index([customerId])
}

// Parts and extra labor lines attached to a ticket. Description and prices are
// snapshotted so later inventory edits never change a past work order.
model TicketItem {
  id             String         @id @default(uuid())
  ticketId       String
  partId         String?
  description    String
  quantity       Int            @default(1)
  unitPriceCents Int
  unitCostCents  Int            @default(0)
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  part           InventoryPart? @relation(fields: [partId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([ticketId])
}

model Payment {
  id          String   @id @default(uuid())
  ticketId    String
  amountCents Int
  method      String // CASH | CARD | DEBIT | E_TRANSFER | OTHER
  note        String?
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

// Append-only activity log: status changes, notes, payments, parts.
model TicketEvent {
  id        String   @id @default(uuid())
  ticketId  String
  kind      String // STATUS | CUSTOMER_NOTE | INTERNAL_NOTE | PAYMENT | ITEM | MESSAGE | SYSTEM
  message   String
  author    String?
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model InventoryPart {
  id           String       @id @default(uuid())
  sku          String       @unique
  name         String
  category     String       @default("GENERAL")
  costCents    Int          @default(0)
  priceCents   Int          @default(0)
  stock        Int          @default(0)
  reorderPoint Int          @default(2)
  supplier     String?
  items        TicketItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model WageRate {
  id                String   @id @default(uuid())
  userId            String
  hourlyRateCents   Int
  overtimeRateCents Int
  effectiveDate     DateTime @default(now())
  reason            String?
  createdById       String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([effectiveDate])
}

model Shift {
  id                String       @id @default(uuid())
  userId            String
  clockIn           DateTime
  clockOut          DateTime?
  status            String       @default("ACTIVE") // ACTIVE | ON_BREAK | COMPLETED
  totalMinutes      Int          @default(0)
  regularMinutes    Int          @default(0)
  overtimeMinutes   Int          @default(0)
  breakMinutes      Int          @default(0)
  notes             String?
  editedByAdminId   String?
  editedAt          DateTime?
  editReason        String?
  originalClockIn   DateTime?
  originalClockOut  DateTime?
  breaks            ShiftBreak[]
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([clockIn])
}

model ShiftBreak {
  id              String    @id @default(uuid())
  shiftId         String
  startTime       DateTime  @default(now())
  endTime         DateTime?
  durationMinutes Int       @default(0)
  type            String    @default("UNPAID_MEAL") // UNPAID_MEAL | PAID_REST
  shift           Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([shiftId])
}

model PayrollPeriod {
  id                    String    @id @default(uuid())
  periodNumber          Int
  periodType            String    @default("BI_WEEKLY") // WEEKLY | BI_WEEKLY | MONTHLY | CUSTOM
  startDate             DateTime
  endDate               DateTime
  payDate               DateTime
  status                String    @default("DRAFT") // DRAFT | APPROVED | FINALIZED
  totalGrossCents       Int       @default(0)
  totalNetCents         Int       @default(0)
  totalDeductionsCents  Int       @default(0)
  finalizedAt           DateTime?
  finalizedById         String?
  notes                 String?
  paystubs              Paystub[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([startDate])
}

model Paystub {
  id                    String        @id @default(uuid())
  payrollPeriodId       String
  userId                String
  regularHours          Float         @default(0)
  overtimeHours         Float         @default(0)
  hourlyRateCents       Int
  overtimeRateCents     Int
  regularPayCents       Int           @default(0)
  overtimePayCents      Int           @default(0)
  bonusCents            Int           @default(0)
  vacationPayCents      Int           @default(0)
  grossPayCents         Int           @default(0)
  cppCents              Int           @default(0)
  eiCents               Int           @default(0)
  incomeTaxCents        Int           @default(0)
  otherDeductionsCents  Int           @default(0)
  totalDeductionsCents  Int           @default(0)
  netPayCents           Int           @default(0)
  status                String        @default("DRAFT") // DRAFT | APPROVED | PAID
  paidAt                DateTime?
  paymentMethod         String        @default("DIRECT_DEPOSIT") // DIRECT_DEPOSIT | CHEQUE | CASH
  paymentReference      String?
  notes                 String?
  payrollPeriod         PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([payrollPeriodId])
  @@index([userId])
  @@index([status])
}
