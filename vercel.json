{
  "framework": "vite",
  "buildCommand": "prisma generate && vite build && vite build --ssr src/server/serverless.ts --outDir api --emptyOutDir false",
  "outputDirectory": "dist",
  "functions": {
    "api/serverless.js": {
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/serverless.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
