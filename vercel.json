{
  "framework": "vite",
  "regions": ["cle1"],
  "buildCommand": "node scripts/prepare-db.js && prisma generate && vite build && vite build --ssr src/server/serverless.ts --outDir api --emptyOutDir false && rm -f api/manifest.webmanifest api/sw.js",
  "outputDirectory": "dist",
  "functions": {
    "api/serverless.js": {
      "includeFiles": "prisma/**"
    }
  },
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/serverless.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
