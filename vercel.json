{
  "framework": "vite",
  "buildCommand": "prisma generate && vite build && vite build --ssr src/server/serverless.ts --outDir api",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
